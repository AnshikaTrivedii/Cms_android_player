<?xml version="1.0" encoding="utf-8"?>
<!--
  TextureView is required when PlayerView is hosted inside Compose AndroidView.
  Default SurfaceView renders on a separate layer and is commonly covered by
  Compose's opaque backgrounds → black video with audio / STATE_READY still firing.

  resize_mode defaults to fit (letterbox, preserve aspect ratio). VideoPlayer.kt
  switches this to FILL when CMS Stretch to Fit is on so the video is stretched
  to the playback container (non-uniform scale; distortion is intentional).
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="never"
    app:keep_content_on_player_reset="true" />
